PROJECT_NAME           = "Ersa Wearable Platform"
PROJECT_BRIEF          = "Embedded smartwatch firmware and application framework"
OUTPUT_DIRECTORY       = .pio/doxygen
CREATE_SUBDIRS          = YES
ALLOW_UNICODE_NAMES    = YES
OUTPUT_LANGUAGE        = English
OPTIMIZE_OUTPUT_FOR_C  = NO
MARKDOWN_SUPPORT       = YES
USE_MDFILE_AS_MAINPAGE = docs/index.md

INPUT                  = README.md include src tests docs
FILE_PATTERNS          = *.h *.hpp *.c *.cc *.cpp *.md
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */.pio/* */build/* */.git/*
# Generated bitmap tables are assets, not first-party API declarations.
EXCLUDE                = include/fonts/misans_fonts.h

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX          = NO
GENERATE_XML            = YES

QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = NO
