# Maintainer: Ersa Wearable Platform contributors
pkgname=ewctl
# scripts/package_ewctl_arch.sh sets this to latest-stable.rRUN.aATTEMPT.gSHA.
pkgver=0.3.0
pkgrel=1
pkgdesc='USB command-line diagnostics and control for Ersa Wearable watches'
arch=('any')
url='https://github.com/ersascape/ErsaWearableOS'
license=('MIT')
depends=('python' 'python-pyserial' 'python-rich' 'esptool' 'python-construct' 'python-pygdbmi')
provides=('ewctl')
source=('ErsaWearableOS::git+https://github.com/ersascape/ErsaWearableOS.git#branch=master')
sha256sums=('SKIP')

package() {
  install -Dm755 "$srcdir/ErsaWearableOS/scripts/ewctl.py" "$pkgdir/usr/bin/ewctl"
  install -Dm644 "$srcdir/ErsaWearableOS/scripts/ewctl_compat/future/__init__.py" \
    "$pkgdir/usr/lib/ewctl/ewctl_compat/future/__init__.py"
  install -Dm644 "$srcdir/ErsaWearableOS/scripts/ewctl_compat/future/utils.py" \
    "$pkgdir/usr/lib/ewctl/ewctl_compat/future/utils.py"
  install -Dm644 "$srcdir/ErsaWearableOS/docs/ewctl-control-bridge.md" \
    "$pkgdir/usr/share/doc/ewctl/ewctl-control-bridge.md"
  install -Dm644 "$srcdir/ErsaWearableOS/docs/FEATURES.md" \
    "$pkgdir/usr/share/doc/ewctl/FEATURES.md"
  install -Dm644 "$srcdir/ErsaWearableOS/LICENSE" \
    "$pkgdir/usr/share/licenses/ewctl/LICENSE"
}
